rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Refus strict par défaut (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Fonctions d'authentification et de validation RBAC
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Récupération sécurisée du profil utilisateur sans e-mail en dur
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // IMPORTANT : le site web public autorise l'inscription de clients sur ce même
    // projet Firebase. Un simple compte authentifié n'est donc PLUS un collaborateur.
    // Seuls les comptes disposant d'un profil `users/{uid}` (créé par un super_admin)
    // sont considérés comme du personnel FCT.
    function isStaff() {
      return isSignedIn() && getUserRole() != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'clausephwandji044@gmail.com' ||
        getUserRole() == 'super_admin'
      );
    }

    function isDirector() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getUserRole() == 'director'
      );
    }

    function isCashier() {
      return isSignedIn() && (getUserRole() == 'accountant_cashier' || isDirector());
    }

    function isRentalAgent() {
      return isSignedIn() && (getUserRole() == 'rental_agent' || isDirector());
    }

    function isSalesAgent() {
      return isSignedIn() && (getUserRole() == 'sales_agent' || isDirector());
    }

    function isFleetManager() {
      return isSignedIn() && (getUserRole() == 'fleet_manager' || isDirector());
    }

    function isDriver() {
      return isSignedIn() && getUserRole() == 'driver';
    }

    // 2. Collection Users (Profils et RBAC)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isDirector());
      allow list: if isDirector();
      // Seul un super_admin peut créer ou modifier les rôles et permissions
      allow create, update: if isSuperAdmin();
      allow delete: if false; // Interdiction de supprimer des comptes directement (révocation/désactivation uniquement)
    }

    // Collection des permissions configurables des rôles
    match /role_permissions/{roleId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // Journal d'audit de sécurité : STRICTEMENT IMMUABLE
    match /security_audit_logs/{logId} {
      allow read: if isDirector();
      allow create: if isStaff();
      allow update, delete: if false; // Append-only immuable
    }

    // 3. Collection Vehicles (Parc automobile) - DONNÉES INTERNES (VIN, coût d'acquisition...)
    match /vehicles/{vehicleId} {
      allow read: if isStaff();
      allow create, update: if isFleetManager();
      allow delete: if isSuperAdmin();
    }

    // 3 bis. Catalogue PUBLIC du site web : projection assainie alimentée par l'ERP.
    // Lecture ouverte (vitrine), écriture réservée à la gestion de flotte.
    match /public_vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isFleetManager();
    }

    // 4. Collection Rental Contracts (Locations)
    match /rental_contracts/{contractId} {
      // Un chauffeur ne peut lire que les contrats où il est affecté, un client lit ses propres contrats
      allow read: if (isStaff() && (!isDriver() || resource.data.driverId == request.auth.uid))
        || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow create, update: if isRentalAgent();
      allow delete: if isSuperAdmin();
    }

    // 5. Collection Reservations
    match /reservations/{reservationId} {
      allow read: if (isStaff() && !isDriver())
        || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow create, update: if isRentalAgent() || isSalesAgent();
      allow delete: if isSuperAdmin();
    }

    // 5 bis. Demandes de réservation reçues depuis le site web (en attente de validation FCT)
    function isValidWebBooking(d) {
      return d.keys().hasOnly([
          'vehicleId', 'vehicleName', 'customerName', 'customerPhone', 'customerEmail',
          'startDate', 'endDate', 'withDriver', 'notes', 'status', 'source',
          'estimatedTotalXAF', 'customerUid', 'createdAt'
        ])
        && d.keys().hasAll([
          'vehicleId', 'vehicleName', 'customerName', 'customerPhone', 'customerEmail',
          'startDate', 'endDate', 'withDriver', 'status', 'source', 'estimatedTotalXAF', 'createdAt'
        ])
        && isValidId(d.vehicleId)
        && d.vehicleName is string && d.vehicleName.size() <= 160
        && d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 120
        && d.customerPhone is string && d.customerPhone.matches('^\\+?[0-9 ]{8,20}$')
        && d.customerEmail is string && d.customerEmail.size() <= 160
        && d.customerEmail.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.endDate >= d.startDate
        && d.withDriver is bool
        && (!('notes' in d.keys()) || (d.notes is string && d.notes.size() <= 500))
        && d.status == 'PENDING'
        && d.source == 'WEBSITE'
        && d.estimatedTotalXAF is int && d.estimatedTotalXAF >= 0
        && d.createdAt is string && d.createdAt.size() <= 40
        && (!('customerUid' in d.keys()) || (isSignedIn() && d.customerUid == request.auth.uid));
    }

    match /web_bookings/{bookingId} {
      allow create: if isValidId(bookingId) && isValidWebBooking(request.resource.data);
      // Un client ne lit que SES demandes ; le personnel (hors chauffeurs) lit tout.
      allow read: if (isStaff() && !isDriver())
        || (isSignedIn() && resource.data.get('customerUid', null) == request.auth.uid);
      allow update: if isRentalAgent();
      allow delete: if isSuperAdmin();
    }

    // 5 ter. Demandes d'achat / contacts reçus depuis le site web
    function isValidWebLead(d) {
      return d.keys().hasOnly([
          'vehicleId', 'vehicleName', 'fullName', 'phone', 'email', 'interestType',
          'financingNeeded', 'notes', 'status', 'source', 'customerUid', 'createdAt'
        ])
        && d.keys().hasAll([
          'vehicleId', 'vehicleName', 'fullName', 'phone', 'email', 'interestType',
          'status', 'source', 'createdAt'
        ])
        && isValidId(d.vehicleId)
        && d.vehicleName is string && d.vehicleName.size() <= 160
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 120
        && d.phone is string && d.phone.matches('^\\+?[0-9 ]{8,20}$')
        && d.email is string && d.email.size() <= 160
        && d.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && d.interestType in ['PURCHASE', 'TEST_DRIVE', 'CONTACT']
        && (!('financingNeeded' in d.keys()) || d.financingNeeded is bool)
        && (!('notes' in d.keys()) || (d.notes is string && d.notes.size() <= 500))
        && d.status == 'NEW'
        && d.source == 'WEBSITE'
        && d.createdAt is string && d.createdAt.size() <= 40
        && (!('customerUid' in d.keys()) || (isSignedIn() && d.customerUid == request.auth.uid));
    }

    match /web_leads/{leadId} {
      allow create: if isValidId(leadId) && isValidWebLead(request.resource.data);
      allow read: if (isStaff() && (isSalesAgent() || isRentalAgent() || isDirector()))
        || (isSignedIn() && resource.data.get('customerUid', null) == request.auth.uid);
      allow update: if isSalesAgent();
      allow delete: if isSuperAdmin();
    }

    // 6. Collection Sales & CRM
    match /sales/{saleId} {
      allow read: if (isStaff() && !isDriver())
        || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow create, update: if isSalesAgent();
      allow delete: if isSuperAdmin();
    }

    match /customers/{customerId} {
      allow read: if (isStaff() && !isDriver())
        || (isSignedIn() && (customerId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow create, update: if isRentalAgent() || isSalesAgent()
        || (isSignedIn() && customerId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // 7. Collection Caisse (Sessions et Mouvements certifiés)
    match /cash_sessions/{sessionId} {
      allow read: if isStaff() && (isCashier() || isDirector());
      allow create: if isCashier();
      allow update: if isCashier();
      allow delete: if false; // Immuable
    }

    // Journal des flux de caisse : STRICTEMENT IMMUABLE
    // Interdiction totale d'update et de delete pour tout le monde (y compris admin).
    // Les corrections se font EXCLUSIVEMENT par contre-écriture (création d'un mouvement opposé).
    match /cash_movements/{movementId} {
      allow read: if isStaff() && (isCashier() || isDirector());
      allow create: if isCashier();
      allow update, delete: if false;
    }

    // 8. Collection Invoices (Facturation)
    match /invoices/{invoiceId} {
      allow read: if (isStaff() && !isDriver())
        || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow create, update: if isCashier() || isRentalAgent() || isSalesAgent();
      allow delete: if isSuperAdmin();
    }

    // 9. Collection Maintenance & Stock
    match /maintenance/{recordId} {
      allow read: if isStaff();
      allow create, update: if isFleetManager();
      allow delete: if isSuperAdmin();
    }

    match /stock/{itemId} {
      allow read: if isStaff();
      allow create, update: if isFleetManager();
      allow delete: if isSuperAdmin();
    }

    // 10. Collection Drivers
    match /drivers/{driverId} {
      allow read: if isStaff();
      allow create, update: if isFleetManager() || isDirector();
      allow delete: if isSuperAdmin();
    }

    // 11. Documents & Coffre-fort
    match /documents/{docId} {
      // Fichiers privés réservés aux profils autorisés et au client propriétaire
      allow read: if (isStaff() && (
        resource.data.isPrivate == false ||
        isDirector() ||
        isCashier() ||
        isFleetManager()
      )) || (isSignedIn() && (
        resource.data.relatedCustomerId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        resource.data.relatedEntityId == request.auth.uid
      ));
      allow create: if (isStaff() && !isDriver())
        || (isSignedIn() && (request.resource.data.relatedCustomerId == request.auth.uid || request.resource.data.customerEmail == request.auth.token.email));
      allow update: if isStaff() && !isDriver();
      allow delete: if isSuperAdmin();
    }

    // 12. Journal d'Audit & Compteurs
    match /audit_logs/{logId} {
      allow read: if isDirector();
      allow create: if isStaff();
      allow update, delete: if false; // Append-only immuable
    }

    match /document_counters/{counterId} {
      allow read, write: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }
  }
}
